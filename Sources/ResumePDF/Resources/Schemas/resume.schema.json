{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arraypress/swift-resume-pdf/schemas/resume.schema.json",
  "title": "Résumé",
  "description": "A résumé or CV as swift-resume-pdf reads it. Only what identifies a thing is required; everything else defaults.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "summary": {
      "type": "string"
    },
    "experience": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "education": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/education"
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skillGroup"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/project"
      }
    },
    "volunteering": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/credential"
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/publication"
      }
    },
    "awards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/award"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/language"
      }
    },
    "achievements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/achievement"
      }
    },
    "strengths": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/strength"
      }
    },
    "time": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timeSlice"
      }
    },
    "grants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/grant"
      }
    },
    "teaching": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "talks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/publication"
      }
    },
    "service": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "memberships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/credential"
      }
    },
    "interests": {
      "type": "string"
    },
    "references": {
      "type": "string"
    },
    "custom": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/customSection"
      }
    },
    "order": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sectionName"
      },
      "description": "The sections in the order they are drawn. A section with no place here is not drawn."
    },
    "labels": {
      "$ref": "#/$defs/labels"
    },
    "design": {
      "type": "string",
      "description": "A built-in design by name, or a path to a blueprint. Read by the tool; the library ignores it."
    },
    "letterDesign": {
      "type": "string",
      "description": "For a letter beside this résumé."
    },
    "theme": {
      "$ref": "#/$defs/themeSpec"
    },
    "extends": {
      "type": "string",
      "description": "Another spec this one inherits from, resolved from this file's folder. Read by the tool."
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "headline": {
          "type": "string",
          "description": "The role, under the name."
        },
        "location": {
          "type": "string",
          "description": "A city and country."
        },
        "email": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "photo": {
          "type": "string",
          "description": "A path to a JPEG or PNG."
        },
        "qr": {
          "type": "string",
          "description": "An address to print as a code, in the designs that place one."
        },
        "dateOfBirth": {
          "type": "string",
          "description": "A Lebenslauf carries one; a US résumé must not."
        },
        "nationality": {
          "type": "string"
        },
        "maritalStatus": {
          "type": "string"
        },
        "placeOfBirth": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "dateRange": {
      "description": "A start and an end, or one date. Strings, because formatting a date means knowing a locale's conventions; `check` reports the ones without a four-digit year.",
      "oneOf": [
        {
          "type": "string",
          "description": "A single date, such as \"2023\" or \"Mar 2022\"."
        },
        {
          "type": "object",
          "properties": {
            "start": {
              "type": "string"
            },
            "end": {
              "type": "string",
              "description": "Empty for a single date; \"Present\" for a position that has not ended."
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "link": {
      "description": "An address. A bare string prints as the address shortened; an object names the label.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "label": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "url"
          ]
        }
      ]
    },
    "skill": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "level": {
              "type": "number",
              "description": "0 to 1, for the designs that draw bars or dots."
            }
          },
          "additionalProperties": false,
          "required": [
            "name"
          ]
        }
      ]
    },
    "position": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "description": "The title held."
        },
        "organisation": {
          "type": "string"
        },
        "location": {
          "type": "string",
          "description": "A city, not an address."
        },
        "dates": {
          "$ref": "#/$defs/dateRange"
        },
        "summary": {
          "type": "string",
          "description": "One line about the role or the company."
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "What was actually achieved, one per line."
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Technologies or methods, where a design shows them separately."
        }
      },
      "additionalProperties": false,
      "required": [
        "role"
      ]
    },
    "education": {
      "type": "object",
      "properties": {
        "qualification": {
          "type": "string"
        },
        "institution": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "dates": {
          "$ref": "#/$defs/dateRange"
        },
        "grade": {
          "type": "string"
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "qualification"
      ]
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/link"
        },
        "dates": {
          "$ref": "#/$defs/dateRange"
        },
        "summary": {
          "type": "string"
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "skillGroup": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skill"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "credential": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "publication": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "authors": {
          "type": "string"
        },
        "link": {
          "$ref": "#/$defs/link"
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "award": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "issuer": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "language": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "level": {
          "type": "string",
          "description": "\"Native\", \"C1\", \"Conversational\" — printed as written."
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "grant": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "funder": {
          "type": "string"
        },
        "amount": {
          "type": "string"
        },
        "dates": {
          "$ref": "#/$defs/dateRange"
        },
        "role": {
          "type": "string",
          "description": "\"PI\", \"Co-I\"."
        },
        "identifier": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "content": {
      "description": "One block of a custom section, named by its kind. Exactly one key.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "prose": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "prose"
          ]
        },
        {
          "type": "object",
          "properties": {
            "list": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "list"
          ]
        },
        {
          "type": "object",
          "properties": {
            "positions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/position"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "positions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "education": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/education"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "education"
          ]
        },
        {
          "type": "object",
          "properties": {
            "projects": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/project"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "projects"
          ]
        },
        {
          "type": "object",
          "properties": {
            "publications": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/publication"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "publications"
          ]
        },
        {
          "type": "object",
          "properties": {
            "credentials": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/credential"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "credentials"
          ]
        },
        {
          "type": "object",
          "properties": {
            "awards": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/award"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "awards"
          ]
        },
        {
          "type": "object",
          "properties": {
            "grants": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/grant"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "grants"
          ]
        },
        {
          "type": "object",
          "properties": {
            "skills": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/skillGroup"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "skills"
          ]
        },
        {
          "type": "object",
          "properties": {
            "languages": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/language"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "languages"
          ]
        },
        {
          "type": "object",
          "properties": {
            "achievements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/achievement"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "achievements"
          ]
        },
        {
          "type": "object",
          "properties": {
            "strengths": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/strength"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "strengths"
          ]
        }
      ]
    },
    "customSection": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "content": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/content"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "labels": {
      "description": "The section headings and the few words a design has to print. A language code, or the words spelled out.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "en",
            "de"
          ]
        },
        {
          "type": "object",
          "properties": {
            "overrides": {
              "type": "object",
              "description": "A heading per section, keyed by section name.",
              "propertyNames": {
                "type": "string",
                "enum": [
                  "summary",
                  "experience",
                  "education",
                  "skills",
                  "projects",
                  "volunteering",
                  "certifications",
                  "publications",
                  "awards",
                  "languages",
                  "grants",
                  "teaching",
                  "talks",
                  "service",
                  "memberships",
                  "interests",
                  "references",
                  "achievements",
                  "strengths",
                  "time"
                ]
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "present": {
              "type": "string",
              "description": "The word for a position that has not ended."
            },
            "dateSeparator": {
              "type": "string"
            },
            "language": {
              "type": "string",
              "description": "ISO 639-1."
            },
            "contact": {
              "type": "string",
              "description": "The word beside the contact details, where a design labels them."
            },
            "details": {
              "type": "string",
              "description": "The word beside the regional particulars."
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "sectionName": {
      "description": "A built-in section, or `custom:<title>` for one of your own.",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "summary",
            "experience",
            "education",
            "skills",
            "projects",
            "volunteering",
            "certifications",
            "publications",
            "awards",
            "languages",
            "grants",
            "teaching",
            "talks",
            "service",
            "memberships",
            "interests",
            "references",
            "achievements",
            "strengths",
            "time"
          ]
        },
        {
          "type": "string",
          "pattern": "^custom:.+$"
        }
      ]
    },
    "themeSpec": {
      "type": "object",
      "properties": {
        "typeface": {
          "type": "string",
          "description": "inter, sourceSerif, or a name for the files below."
        },
        "typefaceFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Paths to .ttf files: regular, medium, semibold, bold, italic."
          }
        },
        "accent": {
          "type": "string"
        },
        "pageSize": {
          "type": "string"
        },
        "density": {
          "type": "string"
        },
        "scheme": {
          "type": "string"
        },
        "tint": {
          "type": "string"
        },
        "justified": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "description": "How the tool lays the document out. Any flag on the command line beats it."
    },
    "achievement": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "icon": {
          "type": "string",
          "description": "star, flag, bolt, check, diamond, or a section's mark. Empty takes the next in a cycle."
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "strength": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "title"
      ]
    },
    "timeSlice": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "share": {
          "type": "number",
          "description": "A weight, not a percentage: 3, 2, 1 and 50, 33, 17 draw the same ring."
        }
      },
      "additionalProperties": false,
      "required": [
        "label"
      ]
    }
  }
}
